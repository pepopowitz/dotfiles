      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(gkm:*)",
      "Bash(git fix:*)",
      "Bash(st:*)",
      "Bash(supst:*)",
      "Bash(dnst:*)",
      "Bash(upst:*)",
      "Bash(sync:*)",
      "Bash(stack-base:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(npm run:*)",
      "Bash(yarn workspace:*)",
      "Bash(yarn:*)",
      "Bash(npx prettier:*)",
      "Bash(prettier:*)",
      "Bash(oxfmt:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(node:*)",
      "mcp__github-pr-review__get_pr_info",
      "mcp__github-pr-review__get_pr_files",
      "mcp__github-pr-review__get_pending_review"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh workflow run:*)",
      "Bash(st submit:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(npm login:*)",
      "Bash(sudo:*)",
      "Bash(curl -X:*)",
      "Bash(curl -d:*)",
      "Bash(curl --data:*)",
      "mcp__github-pr-review__create_review",
      "mcp__github-pr-review__add_review_comment",
      "mcp__github-pr-review__submit_review_event"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(//Users/Steven.Hicks/.ssh/**)",
      "Read(//Users/Steven.Hicks/.aws/**)",
      "Read(//Users/Steven.Hicks/.gnupg/**)",
      "Read(//Users/Steven.Hicks/.config/gh/**)",
      "Read(//Users/Steven.Hicks/.npmrc)",
      "Read(//Users/Steven.Hicks/Library/Keychains/**)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Local, reversible work in the repo: reading and searching any tracked file, editing source, running builds, tests, formatters and linters, and local git operations (add, commit, stash, restore, branch switching) including the `st` stack tooling.",
      "Writing to the session scratchpad directory and to docs/ and docs/plans/."
    ],
    "soft_deny": [
      "$defaults",
      "Anything that leaves this machine or becomes visible to other people: pushing to a remote, creating or editing pull requests, issues, comments or releases, `st submit`, publishing packages, or POSTing to an external API. Steve gates these himself.",
      "Rewriting published git history, force-pushing, or deleting a branch or tag that is not prefixed `claude/`."
    ],
    "hard_deny": [
      "$defaults",
      "Reading, printing, copying, decoding or editing any secret-bearing file by ANY means — including via shell commands like cat, grep, sed, perl, cp, base64 or a script — specifically: .env and .env.* (a .env.example, .env.sample or .env.template is fine), ~/.ssh, ~/.aws, ~/.gnupg, ~/.config/gh, ~/.npmrc, keychains, and any *.pem, *.p12 or id_rsa/id_ed25519 key.",
      "Sending the contents of any credential, token or API key to a network destination, writing one into a file that is not already gitignored, or echoing one into the transcript."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/guard-claude-config.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/deny-secret-commands.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/log-action.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/log-action.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh \"Excuse me?\""
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh \"Hey bruh...\" \"Pssst...\" \"Baby come back...\" \"Yoohoo...\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); RUNNING=$(echo \"$INPUT\" | jq '[(.background_tasks // [])[] | select(.status==\"running\")] | length'); if [ \"${RUNNING:-0}\" -eq 0 ]; then echo \"$INPUT\" | ~/.claude/scripts/notify.sh \"As you wish...\" \"All set chief...\" \"Baby come back...\" \"What's next???\"; fi"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/session-digest.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "compound-engineering@every-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "git",
        "url": "https://github.com/EveryInc/every-marketplace.git"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Doing stuff",
      "Doing things",
      "Working",
      "Thinking",
      "Spinning out",
      "Crashing out",
      "Making stuff",
      "Making things",
      "Daydreaming",
      "Procrastinating",
      "Avoiding responsibility",
      "M I X ing the egg into the bowl",
      "Doing a Cross|word but telling you I'm actually working",
      "Flipping art",
      "Playing Circuits",
      "Ribbiting",
      "Getting lost in a Sudoku",
      "Moving colored tiles around",
      "Typeshifting",
      "Struggling at Bongo",
      "Clearing cubes",
      "Trying to remember where the 5s are",
      "Clearing SpellTower",
      "Pretending to be deterministic",
      "Forgetting your instructions",
      "Burning tokens",
      "Hemorrhaging tokens",
      "Dumping buckets of tokens into the ocean",
      "Burning the Amazon",
      "Boiling Lake Michigan",
      "Predicting text",
      "Smooshing 1s and 0s",
      "Pretending to follow your instructions",
      "Stealing all your joy",
      "Doing the good parts of your job for you"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "prefersReducedMotion": true,
  "theme": "light",
  "mcpServers": {
    "github-pr-review": {
      "command": "node",
      "args": [
        "/Users/stevenhicks/.claude/mcp-servers/github-pr-review/index.js"
      ]
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754333339275
  },
  "model": "opus[1m]"
}
